#!/bin/bash

# Copyright (c) 2026 07dcolem
#
# Ask the desktop portal for one local file and print its path.
# The dialog runs outside the shell. This script does not open, hash, or run the file.
# Request.Response is delivered only to the connection that called OpenFile, so a
# second monitor never sees it. The helper below calls and waits on one connection.
# Exit 0 prints one path. Exit 1 is a cancelled chooser. Exit 2 is a chooser failure.

set -euo pipefail
LC_ALL=C

MAX_PATH=4096

MON_PID=""

die() {
  printf '%s\n' "$1" >&2
  exit 2
}

# shellcheck disable=SC2329 # trap callback; shellcheck does not count trap arguments as calls
child_pids() {
  local pid=$1 child
  [[ $pid =~ ^[0-9]+$ ]] || return 0
  while read -r child; do
    [[ $child =~ ^[0-9]+$ ]] || continue
    printf '%s\n' "$child"
  done < <(ps -o pid= --ppid "$pid" 2>/dev/null || true)
}

# shellcheck disable=SC2329
stop_pid() {
  local pid=$1 n
  [[ $pid =~ ^[0-9]+$ ]] || return 0
  kill -TERM "$pid" 2>/dev/null || true
  n=0
  while ((n < 5)); do
    kill -0 "$pid" 2>/dev/null || return 0
    sleep 0.05
    n=$((n + 1))
  done
  kill -KILL "$pid" 2>/dev/null || true
  wait "$pid" 2>/dev/null || true
}

# shellcheck disable=SC2329
stop_tree() {
  local pid=$1 child
  [[ $pid =~ ^[0-9]+$ ]] || return 0
  while read -r child; do
    stop_tree "$child"
  done < <(child_pids "$pid")
  stop_pid "$pid"
}

# shellcheck disable=SC2329
cleanup() {
  local status=$?
  trap - EXIT INT TERM
  set +e
  exec 4<&- 2>/dev/null || true
  stop_tree "$MON_PID"
  MON_PID=""
  exit "$status"
}
trap cleanup EXIT
trap 'exit 1' INT TERM

start_ok() {
  local path=$1
  [[ $path == /* ]] || return 1
  ((${#path} <= MAX_PATH)) || return 1
  [[ $path != *$'\n'* && $path != *$'\r'* ]] || return 1
  [[ -d $path && ! -L $path ]]
}

# hyprctl prints "Window <hex> -> ...". The selector wants 0x plus that hex.
# Prints "<address> <floating>" for the chooser. floating is 0, 1, or empty.
# Only that address is passed on. A window title is not.
chooser_address() {
  local dump=$1 line hex="" class="" title="" floating=""
  while IFS= read -r line || [[ -n $line ]]; do
    if [[ $line =~ ^Window\ (0x[0-9a-fA-F]+|[0-9a-fA-F]+)\  ]]; then
      if [[ $class == xdg-desktop-portal-gtk && $title == "Add an AppImage" && $hex =~ ^0x[0-9a-fA-F]+$ ]]; then
        printf '%s %s' "$hex" "$floating"
        return 0
      fi
      hex=${BASH_REMATCH[1]}
      [[ $hex == 0x* ]] || hex=0x$hex
      [[ $hex =~ ^0x[0-9a-fA-F]+$ ]] || hex=""
      class=""
      title=""
      floating=""
    elif [[ $line =~ ^[[:space:]]class:\ (.*)$ ]]; then
      class=${BASH_REMATCH[1]}
    elif [[ $line =~ ^[[:space:]]title:\ (.*)$ ]]; then
      title=${BASH_REMATCH[1]}
    elif [[ $line =~ ^[[:space:]]floating:\ ([01])$ ]]; then
      floating=${BASH_REMATCH[1]}
    fi
  done <<<"$dump"
  if [[ $class == xdg-desktop-portal-gtk && $title == "Add an AppImage" && $hex =~ ^0x[0-9a-fA-F]+$ ]]; then
    printf '%s %s' "$hex" "$floating"
    return 0
  fi
  return 1
}

# A fullscreen window covers every normal window, including one that is focused.
# Pin draws this chooser above that window and leaves the other window fullscreen.
# float set on Hyprland 0.56 tiles a window that is already floating, which then
# cannot be pinned, so that command runs only when the chooser is tiled.
raise_chooser() {
  local n=0 dump state addr floating
  [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]] || return 0
  command -v hyprctl >/dev/null 2>&1 || return 0
  command -v timeout >/dev/null 2>&1 || return 0
  command -v head >/dev/null 2>&1 || return 0
  while ((n < 10)); do
    n=$((n + 1))
    dump=$(timeout -k 1 -- 1 hyprctl clients 2>/dev/null | head -c 262144 || true)
    if state=$(chooser_address "$dump"); then
      addr=${state%% *}
      floating=${state#* }
      [[ $addr =~ ^0x[0-9a-fA-F]+$ ]] || return 0
      if [[ $floating == 0 ]]; then
        timeout -k 1 -- 1 hyprctl dispatch "hl.dsp.window.float({ window = \"address:$addr\", action = \"set\" })" >/dev/null 2>&1 || true
      fi
      timeout -k 1 -- 1 hyprctl dispatch "hl.dsp.window.pin({ window = \"address:$addr\", action = \"set\" })" >/dev/null 2>&1 || true
      timeout -k 1 -- 1 hyprctl dispatch "hl.dsp.focus({ window = \"address:$addr\" })" >/dev/null 2>&1 || true
      timeout -k 1 -- 1 hyprctl dispatch "hl.dsp.window.alter_zorder({ window = \"address:$addr\", mode = \"top\" })" >/dev/null 2>&1 || true
      timeout -k 1 -- 1 hyprctl dispatch "hl.dsp.window.bring_to_top({ window = \"address:$addr\" })" >/dev/null 2>&1 || true
      return 0
    fi
    sleep 0.1
  done
}

choose_folder() {
  local candidate=$1
  if [[ -n $candidate ]] && start_ok "$candidate"; then
    printf '%s' "$candidate"
    return 0
  fi
  if [[ -n ${HOME:-} ]] && start_ok "$HOME/Downloads"; then
    printf '%s' "$HOME/Downloads"
    return 0
  fi
  if [[ -n ${HOME:-} ]] && start_ok "$HOME"; then
    printf '%s' "$HOME"
    return 0
  fi
  return 1
}

decode_file_uri() {
  local uri=$1 rest="" path="" hex byte
  if [[ $uri == file://localhost/* ]]; then
    rest=${uri#file://localhost}
  elif [[ $uri == file:///* ]]; then
    rest=${uri#file://}
  else
    return 1
  fi
  ((${#rest} <= 12000)) || return 1
  while [[ -n $rest ]]; do
    if [[ $rest == %* ]]; then
      [[ $rest =~ ^%[0-9A-Fa-f]{2} ]] || return 1
      hex=${rest:1:2}
      [[ ${hex,,} != 00 ]] || return 1
      printf -v byte '%b' "\\x$hex"
      path+=$byte
      rest=${rest:3}
    else
      path+=${rest:0:1}
      rest=${rest:1}
    fi
  done
  [[ $path == /* ]] || return 1
  [[ $path != *$'\n'* && $path != *$'\r'* ]] || return 1
  ((${#path} >= 2 && ${#path} <= MAX_PATH)) || return 1
  printf '%s' "$path"
}

if (($# > 1)); then
  die "Could not open the file chooser."
fi

command -v timeout >/dev/null || die "Could not open the file chooser."
# OMARCHY_APPIMAGE_PICK_PY is the test double. The panel does not set it.
if [[ -z ${OMARCHY_APPIMAGE_PICK_PY:-} && ! -x /usr/bin/python3 ]]; then
  die "Could not open the file chooser. omarchy pkg add python"
fi

folder=""
if chosen=$(choose_folder "${1:-}"); then
  folder=$chosen
fi

# The helper prints "0" and a file URI, "1" for cancel, or "2" for failure.
# It stays up until the dialog closes, so the window can be pinned while it waits.
exec 4< <(
  if [[ -n ${OMARCHY_APPIMAGE_PICK_PY:-} ]]; then
    timeout -k 2 -- 180 "$OMARCHY_APPIMAGE_PICK_PY" "$folder"
  else
    timeout -k 2 -- 180 /usr/bin/python3 -I - "$folder" <<'PY'
import secrets
import signal
import sys

try:
    import gi

    gi.require_version("Gio", "2.0")
    gi.require_version("GLibUnix", "2.0")
    from gi.repository import Gio, GLib, GLibUnix
except Exception:
    sys.stderr.write("Could not open the file chooser. omarchy pkg add python-gobject\n")
    raise SystemExit(2)

folder = sys.argv[1] if len(sys.argv) > 1 else ""
token = "pick" + secrets.token_hex(16)
bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
unique = bus.get_unique_name()
if not unique or not unique.startswith(":"):
    sys.stderr.write("Could not open the file chooser.\n")
    raise SystemExit(2)
sender = unique[1:].replace(".", "_")
handle = "/org/freedesktop/portal/desktop/request/" + sender + "/" + token
loop = GLib.MainLoop()
state = {"done": False, "handle": handle}

def close_request():
    try:
        bus.call_sync(
            "org.freedesktop.portal.Desktop",
            state["handle"],
            "org.freedesktop.portal.Request",
            "Close",
            None,
            None,
            Gio.DBusCallFlags.NONE,
            2000,
            None,
        )
    except Exception:
        pass

def on_response(_conn, _sender, path, _interface, _signal, params):
    if path != state["handle"] or state["done"]:
        return
    code, results = params.unpack()
    uris = []
    if isinstance(results, dict):
        found = results.get("uris") or []
        if isinstance(found, (list, tuple)):
            uris = list(found)
    state["done"] = True
    if code == 1:
        sys.stdout.write("1\n")
    elif code == 0 and len(uris) == 1 and isinstance(uris[0], str):
        uri = uris[0]
        if 0 < len(uri) <= 12000 and "\n" not in uri and "\r" not in uri:
            sys.stdout.write("0\n")
            sys.stdout.write(uri + "\n")
        else:
            sys.stdout.write("2\n")
    else:
        sys.stdout.write("2\n")
    sys.stdout.flush()
    loop.quit()

bus.signal_subscribe(
    None,
    "org.freedesktop.portal.Request",
    "Response",
    handle,
    None,
    Gio.DBusSignalFlags.NONE,
    on_response,
)

opts = {
    "handle_token": GLib.Variant("s", token),
    "multiple": GLib.Variant("b", False),
    # modal is the portal default. false leaves the dialog under the focused window.
    "modal": GLib.Variant("b", True),
    "accept_label": GLib.Variant("s", "Add"),
    "filters": GLib.Variant(
        "a(sa(us))",
        [("AppImages", [(0, "*.[aA][pP][pP][iI][mM][aA][gG][eE]")])],
    ),
}
if folder:
    opts["current_folder"] = GLib.Variant("ay", list((folder + "\0").encode()))

try:
    reply = bus.call_sync(
        "org.freedesktop.portal.Desktop",
        "/org/freedesktop/portal/desktop",
        "org.freedesktop.portal.FileChooser",
        "OpenFile",
        GLib.Variant("(ssa{sv})", ("", "Add an AppImage", opts)),
        GLib.VariantType.new("(o)"),
        Gio.DBusCallFlags.NONE,
        30000,
        None,
    )
except Exception:
    sys.stderr.write("Could not open the file chooser.\n")
    raise SystemExit(2)

returned = reply.unpack()[0]
if (
    not isinstance(returned, str)
    or len(returned) > 256
    or not returned.startswith("/org/freedesktop/portal/desktop/request/")
):
    sys.stderr.write("Could not open the file chooser.\n")
    raise SystemExit(2)
allowed = set("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_/")
if any(ch not in allowed for ch in returned):
    sys.stderr.write("Could not open the file chooser.\n")
    raise SystemExit(2)
if returned != handle:
    state["handle"] = returned
    bus.signal_subscribe(
        None,
        "org.freedesktop.portal.Request",
        "Response",
        returned,
        None,
        Gio.DBusSignalFlags.NONE,
        on_response,
    )

def stop():
    if not state["done"]:
        close_request()
    loop.quit()
    return GLib.SOURCE_REMOVE

GLibUnix.signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, stop)
GLib.timeout_add_seconds(175, stop)
loop.run()
if not state["done"]:
    raise SystemExit(2)
PY
  fi
)
MON_PID=$!

raise_chooser

if ! IFS= read -r -u 4 status_line; then
  exit 2
fi
status_line=${status_line%$'\r'}
if [[ $status_line == 1 ]]; then
  exit 1
fi
[[ $status_line == 0 ]] || exit 2
if ! IFS= read -r -u 4 uri; then
  exit 2
fi
uri=${uri%$'\r'}
path=$(decode_file_uri "$uri") || die "The file chooser returned a path this plugin will not use."
printf '%s\n' "$path"
exit 0
