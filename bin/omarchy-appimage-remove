#!/bin/bash

# Copyright (c) 2026 Juan I. de Elizalde

# omarchy:summary=Remove an AppImage desktop launcher
# omarchy:args=[name] [--keep-file] [--drop-duplicates] [--show-shortcuts]

set -e

ICON_BASE="$HOME/.local/share/icons/hicolor"
DESKTOP_DIR="$HOME/.local/share/applications"

desktop_payload_path() {
  # The payload path is stored in its own X-AppImage-Payload key rather than
  # parsed back out of Exec. Exec still carries the fully quoted and escaped
  # path -- that is how the app launches, and the spec requires it -- but reading
  # it back meant undoing two escaping layers in a fixed order, which is how a
  # payload once survived removal. A dedicated key goes through desktop-entry
  # string escaping only, and install rejects tab, CR and LF in the path, so the
  # only escapes that can appear are a doubled backslash and a leading \s.
  local payload
  payload=$(sed -n 's/^X-AppImage-Payload=//p' "$1" | head -1)
  [[ $payload == "\\s"* ]] && payload=" ${payload#\\s}"
  printf '%s' "${payload//\\\\/\\}"
}

# True when the unescaped Exec or TryExec names this payload as its own word.
# Quotes are turned into spaces first. The payload is a literal, not a pattern.
exec_mentions_payload() {
  local exec=$1 payload=$2 wrapped candidate
  [[ -n $payload ]] || return 1
  [[ $payload != *$'\n'* && $payload != *$'\r'* ]] || return 1
  wrapped=" $exec "
  wrapped=${wrapped//\"/ }
  wrapped=${wrapped//\'/ }
  candidate=${wrapped%%" $payload "*}
  [[ $candidate != "$wrapped" ]]
}

desktop_value() {
  local file=$1 key=$2 size
  [[ -f $file && ! -L $file ]] || return 0
  size=$(stat -c '%s' -- "$file" 2>/dev/null || printf '999999999')
  [[ $size =~ ^[0-9]+$ ]] && ((size <= 65536)) || return 0
  sed -n "s/^${key}=//p" "$file" | head -1
}

# A foreign desktop file counts as the app's own shortcut only when the menu
# would show it. Hidden and NoDisplay files are handlers, not a second listing.
desktop_menu_visible() {
  local hidden display
  hidden=$(desktop_value "$1" Hidden)
  display=$(desktop_value "$1" NoDisplay)
  [[ $hidden == true || $display == true ]] && return 1
  return 0
}

# True when this plugin hid the shortcut and left the desktop file in place.
launcher_suppressed() {
  local file=$1
  [[ -f $file && ! -L $file ]] || return 1
  grep -qx 'NoDisplay=true' -- "$file" \
    && grep -qx 'X-AppImage-Suppressed=duplicate' -- "$file"
}

# mode is hide or show. The desktop file stays, so the panel list still finds
# the app. hide sets NoDisplay so the app launcher skips our shortcut. show
# removes only the lines this plugin added.
rewrite_launcher() {
  local file=$1 mode=$2 tmp old_umask status modebits
  [[ $mode == hide || $mode == show ]] || return 1
  [[ -f $file && ! -L $file ]] || return 1
  [[ -d $DESKTOP_DIR && ! -L $DESKTOP_DIR ]] || return 1
  old_umask=$(umask)
  umask 077
  tmp=$(mktemp -p "$DESKTOP_DIR" ".appimage-desktop.XXXXXXXXXX")
  status=$?
  umask "$old_umask"
  ((status == 0)) || return 1
  if ! (
    local line bytes=0 in_entry=0 seen_entry=0 wrote_tail=0
    while IFS= read -r line || [[ -n $line ]]; do
      bytes=$((bytes + ${#line} + 1))
      ((bytes <= 65536)) || exit 1
      if [[ $line =~ ^\[([^]]+)\]$ ]]; then
        if ((in_entry)) && [[ $mode == hide ]] && ((wrote_tail == 0)); then
          printf '%s\n' 'NoDisplay=true' 'X-AppImage-Suppressed=duplicate'
          wrote_tail=1
        fi
        if [[ ${BASH_REMATCH[1]} == "Desktop Entry" ]]; then
          in_entry=1
          seen_entry=1
        else
          in_entry=0
        fi
        printf '%s\n' "$line"
        continue
      fi
      if ((in_entry)); then
        case $line in
        'NoDisplay='* | 'X-AppImage-Suppressed='*) continue ;;
        esac
      fi
      printf '%s\n' "$line"
    done <"$file"
    ((seen_entry == 1)) || exit 1
    if [[ $mode == hide ]] && ((wrote_tail == 0)); then
      printf '%s\n' 'NoDisplay=true' 'X-AppImage-Suppressed=duplicate'
    fi
  ) >"$tmp"; then
    rm -f -- "$tmp"
    return 1
  fi
  modebits=$(stat -c '%a' -- "$file" 2>/dev/null || printf '644')
  chmod -- "$modebits" "$tmp" || {
    rm -f -- "$tmp"
    return 1
  }
  mv -f -T -- "$tmp" "$file"
}

# Hide this plugin's app-launcher shortcut when another visible desktop file
# names the same payload, or show it again. The desktop file, its icon, and
# the AppImage stay, so the panel list does not lose the app.
reconcile_shortcuts() {
  local mode=$1
  local -a plugin_files=() plugin_payloads=() foreign_execs=()
  local file count=0 payload exec_line try_line mentioned
  local i changes=0 hidden=0 restored=0
  local hidden_name="" restored_name=""
  [[ $mode == hide || $mode == show ]] || return 1
  [[ -d $DESKTOP_DIR && ! -L $DESKTOP_DIR ]] || return 0
  while IFS= read -r -d '' file; do
    count=$((count + 1))
    ((count <= 400)) || break
    if grep -q '^Exec=.*omarchy-launch-appimage' "$file"; then
      [[ -f $file && ! -L $file ]] || continue
      payload=$(desktop_payload_path "$file")
      [[ -n $payload ]] || continue
      plugin_files+=("$file")
      plugin_payloads+=("$payload")
      continue
    fi
    desktop_menu_visible "$file" || continue
    exec_line=$(desktop_value "$file" Exec)
    try_line=$(desktop_value "$file" TryExec)
    [[ -n $exec_line ]] && foreign_execs+=("$exec_line")
    [[ -n $try_line ]] && foreign_execs+=("$try_line")
  done < <(find -P "$DESKTOP_DIR" -maxdepth 3 -type f -name '*.desktop' -print0 2>/dev/null || true)

  for i in "${!plugin_files[@]}"; do
    ((changes < 20)) || break
    file=${plugin_files[$i]}
    payload=${plugin_payloads[$i]}
    mentioned=0
    if [[ $mode == hide ]]; then
      for exec_line in "${foreign_execs[@]}"; do
        if exec_mentions_payload "$exec_line" "$payload"; then
          mentioned=1
          break
        fi
      done
    fi
    if [[ $mode == hide ]] && ((mentioned)); then
      launcher_suppressed "$file" && continue
      rewrite_launcher "$file" hide || continue
      hidden=$((hidden + 1))
      changes=$((changes + 1))
      hidden_name=$(basename "${file%.desktop}")
    elif launcher_suppressed "$file"; then
      rewrite_launcher "$file" show || continue
      restored=$((restored + 1))
      changes=$((changes + 1))
      restored_name=$(basename "${file%.desktop}")
    fi
  done
  ((changes)) || return 0
  update-desktop-database "$DESKTOP_DIR" &>/dev/null || true
  if ((hidden == 1 && restored == 0)); then
    printf 'Hid the shortcut for %s. It stays in this list.\n' "$hidden_name"
  elif ((hidden > 1 && restored == 0)); then
    printf 'Hid %s shortcuts that duplicated an app shortcut. They stay in this list.\n' "$hidden"
  elif ((restored == 1 && hidden == 0)); then
    printf 'Restored the shortcut for %s.\n' "$restored_name"
  elif ((restored > 1 && hidden == 0)); then
    printf 'Restored %s shortcuts.\n' "$restored"
  else
    printf 'Updated shortcuts. Installed apps stay in this list.\n'
  fi
}

KEEP_FILE=false
DROP_DUPLICATES=false
SHOW_SHORTCUTS=false
ARGS=()
for arg in "$@"; do
  if [[ $arg == "--keep-file" ]]; then
    KEEP_FILE=true
  elif [[ $arg == "--drop-duplicates" ]]; then
    DROP_DUPLICATES=true
  elif [[ $arg == "--show-shortcuts" ]]; then
    SHOW_SHORTCUTS=true
  else
    ARGS+=("$arg")
  fi
done

if [[ $DROP_DUPLICATES == true || $SHOW_SHORTCUTS == true ]]; then
  if ((${#ARGS[@]})) || [[ $KEEP_FILE == true ]] || [[ $DROP_DUPLICATES == true && $SHOW_SHORTCUTS == true ]]; then
    echo "Could not check shortcuts." >&2
    exit 2
  fi
  if [[ $DROP_DUPLICATES == true ]]; then
    reconcile_shortcuts hide
  else
    reconcile_shortcuts show
  fi
  exit 0
fi

# Always index the launchers, so removal deletes the file that was found rather
# than a path rebuilt from the displayed name. Installs predating the name
# validation could nest the launcher inside directories, and those are exactly
# the ones a reconstructed path cannot reach.
APPS=()
APP_PATHS=()
while IFS= read -r -d '' file; do
  if grep -q '^Exec=.*omarchy-launch-appimage' "$file"; then
    APPS+=("$(basename "${file%.desktop}")")
    APP_PATHS+=("$file")
  fi
done < <(find "$DESKTOP_DIR" -name '*.desktop' -print0 2>/dev/null)

path_for_app() {
  local wanted="$1" i
  for i in "${!APPS[@]}"; do
    if [[ ${APPS[$i]} == "$wanted" ]]; then
      printf '%s\n' "${APP_PATHS[$i]}"
      return 0
    fi
  done
}

if ((${#ARGS[@]} == 0)); then
  if ((${#APPS[@]})); then
    mapfile -t SORTED < <(printf '%s\n' "${APPS[@]}" | sort)
    APP_NAME=$(omarchy-menu-select "Select AppImage to remove" "${SORTED[@]}" -- --width 520 --maxheight 520)
  else
    echo "No AppImages to remove."
    exit 1
  fi
else
  APP_NAME="${ARGS[*]}"
fi

if [[ -z $APP_NAME ]]; then
  echo "You must select an AppImage to remove."
  exit 1
fi

DESKTOP_FILE=$(path_for_app "$APP_NAME")
DESKTOP_FILE="${DESKTOP_FILE:-$DESKTOP_DIR/$APP_NAME.desktop}"

PAYLOAD=""
if [[ -f $DESKTOP_FILE ]]; then
  PAYLOAD=$(desktop_payload_path "$DESKTOP_FILE")
fi

icon_name=$(printf '%s\n' "$APP_NAME" | tr '[:upper:]' '[:lower:]' | sed 's/[^[:alnum:]]\+/-/g; s/^-//; s/-$//')

rm -f "$DESKTOP_FILE"

# Install files the icon under the hicolor size matching its real resolution, so
# sweep every size directory rather than assuming 256x256. Missing one orphans
# the icon.
while IFS= read -r -d '' icon; do
  rm -f "$icon"
done < <(find "$ICON_BASE" -mindepth 2 -maxdepth 3 -type f -name "$icon_name.*" -print0 2>/dev/null)

if [[ $KEEP_FILE == false && -n $PAYLOAD && -f $PAYLOAD ]]; then
  rm -f "$PAYLOAD"
fi

if [[ ${OMARCHY_REMOVE_NOTIFY:-true} != "false" ]]; then
  omarchy-notification-send -g "AppImage removed" "$APP_NAME"
fi

update-desktop-database "$DESKTOP_DIR" &>/dev/null || true
