{
  "schemaVersion": 1,
  "id": "07dcolem.appimages",
  "name": "AppImages",
  "version": "0.1.11",
  "author": "07dcolem",
  "license": "MIT",
  "description": "Install, update, list, and remove AppImages from the bar.",
  "kinds": ["bar-widget", "panel"],
  "entryPoints": {
    "barWidget": "BarWidget.qml",
    "panel": "Panel.qml"
  },
  "barWidget": {
    "displayName": "AppImages",
    "category": "System",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "openWithPanel": false,
      "dropDuplicateLaunchers": false
    },
    "schema": [
      {
        "key": "openWithPanel",
        "type": "boolean",
        "label": "Set AppImage File Association",
        "defaultValue": false
      },
      {
        "key": "dropDuplicateLaunchers",
        "type": "boolean",
        "label": "Drop our shortcut if the app added one",
        "defaultValue": false
      }
    ]
  }
}
